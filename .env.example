ANTHROPIC_API_KEY=your-key-here

# ---------------------------------------------------------------------------
# Cloud deploy only. Leave all three unset to run locally against the Excel
# file (no auth, no Supabase). Find the keys in your Supabase dashboard under
# Project Settings → API.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://xxxx.supabase.co
#
# Public anon key — used for all per-user data access. Row-level security is
# enforced, so this key is safe to use for ordinary requests.
# SUPABASE_ANON_KEY=your-anon-key
#
# Service-role key — bypasses row-level security; used ONLY for account
# deletion (auth.admin.delete_user). Optional: omit it and account deletion
# will remove the user's data but not the auth account itself.
# SUPABASE_SERVICE_KEY=your-service-role-key
